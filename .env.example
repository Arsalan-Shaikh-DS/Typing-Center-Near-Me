# --- Gmail SMTP (for lead email notifications) ---
# The Gmail address that will SEND the notification emails
GMAIL_USER=you@gmail.com
# A 16-character Gmail "App Password" — NOT your normal Gmail password.
# Generate one at https://myaccount.google.com/apppasswords (requires 2-Step Verification on)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Where lead emails should be delivered (can be the same as GMAIL_USER)
LEAD_EMAIL_TO=you@gmail.com

# --- Google Sheets (for lead logging) ---
# The /exec URL from your deployed Google Apps Script Web App.
# See README-LEADS.md for how to get this.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXXXXX/exec
